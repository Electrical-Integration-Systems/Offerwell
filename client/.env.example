# Local Docker services (see ../docker/README.md).
NEXT_PUBLIC_TYPESENSE_HOST=127.0.0.1
NEXT_PUBLIC_TYPESENSE_PORT=8108
NEXT_PUBLIC_TYPESENSE_PROTOCOL=http
# Use the `value` returned by `bun run search-key` in ../docker.
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=<LOCAL_SEARCH_ONLY_KEY>
# Copy TYPESENSE_DEV_API_KEY from ../docker/.env.dev. Server only.
TYPESENSE_API_KEY=<LOCAL_TYPESENSE_ADMIN_KEY>

OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
# Production can continue using OPEN_WEBUI_BASE_URL and OPEN_WEBUI_API_KEY
# when OLLAMA_BASE_URL is unset.

# Let the Convex CLI write these for the selected LOCAL deployment.
# CONVEX_DEPLOYMENT=local:...
# NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
# Convex function secrets are set with `bunx convex env set`, not here.
